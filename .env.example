PORT=8711
HOST=127.0.0.1
WEBHOOK_SECRET=change-me
FORWARDER_SECRET=change-me
BOT_NAME=QiuShi

# ClawBot/iLink direct WeChat integration.
CLAWBOT_BASE_URL=https://ilinkai.weixin.qq.com
CLAWBOT_DEFAULT_USER=wife
CLAWBOT_USERS=wife
CLAWBOT_STATE_DIR=.clawbot/users
CLAWBOT_POLL_INTERVAL_MS=3000
CLAWBOT_SEND_MAX_RETRIES=3
CLAWBOT_AUTO_LISTEN=true

# Optional: query creator updates in the local Benshi project from WeChat.
# Include CREATOR_UPDATES_USER in CLAWBOT_USERS to receive commands.
CREATOR_UPDATES_QUERY_URL=
CREATOR_UPDATES_USER=me
# Defaults to FORWARDER_SECRET; must match Benshi WECHAT_FORWARDER_SECRET.
CREATOR_UPDATES_QUERY_SECRET=
